# Configure this only when cloud generation or web search is requested.
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_MODEL=glm-5.2
ZHIPU_CHAT_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_SEARCH_URL=https://open.bigmodel.cn/api/paas/v4/web_search

# These are initial checkbox values for the local Gradio UI only. The REST API
# always requires explicit allow_cloud / allow_web values on each answer.
RAG_ALLOW_CLOUD_DEFAULT=false
RAG_ALLOW_WEB_DEFAULT=false

# Local UI is ephemeral by default. The production API requires persistence.
RAG_PERSIST_DATA=false
RAG_STORAGE_ROOT=.rag_data
RAG_API_DOCS_ENABLED=true

# Map each high-entropy API key (16+ characters) to one tenant principal.
RAG_API_KEYS_JSON={"replace-with-a-long-random-key":{"subject":"local-admin","tenant_id":"local","roles":["reader","writer","operator"]}}

# Background work, admission control, quotas, and per-node rate limiting.
RAG_JOB_WORKERS=4
RAG_MAX_JOBS=128
RAG_MAX_JOBS_PER_TENANT=32
RAG_JOB_TTL=3600
RAG_MAX_CONCURRENT_ANSWERS=4
RAG_MAX_TENANT_STORAGE_BYTES=1073741824
RAG_MAX_FILES_PER_TENANT=1000
RAG_RATE_LIMIT_PER_SECOND=2.0
RAG_RATE_LIMIT_CAPACITY=20.0
RAG_RATE_LIMIT_MAX_TENANTS=10000

# Retrieval and model tuning. Calibrate confidence on a held-out dataset.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CHUNK_SIZE=480
RAG_CHUNK_OVERLAP=80
RAG_DENSE_CANDIDATES=24
RAG_SPARSE_CANDIDATES=24
RAG_FUSED_CANDIDATES=12
RAG_FINAL_EVIDENCE=5
RAG_LOCAL_CONFIDENCE=0.58
RAG_RERANKER_MODEL=
RAG_RERANKER_WEIGHT=0.65

# Upload, parsing, prompt, and network resource boundaries.
RAG_MAX_FILE_BYTES=5242880
RAG_MAX_TOTAL_BYTES=20971520
RAG_MAX_DOCUMENTS=10
RAG_MAX_CHUNKS=2000
RAG_MAX_DOCUMENT_CHARACTERS=2000000
RAG_MAX_PDF_PAGES=200
RAG_MAX_ARCHIVE_UNCOMPRESSED_BYTES=20971520
RAG_MAX_QUESTION_CHARACTERS=2000
RAG_MAX_CONTEXT_CHARACTERS=18000
RAG_CONNECT_TIMEOUT=10.0
RAG_READ_TIMEOUT=60.0
RAG_RETRY_ATTEMPTS=2

# Bounded conversation memory and research-mode budgets.
RAG_SESSION_TTL=3600
RAG_MAX_SESSIONS=32
RAG_MEMORY_MAX_ROUNDS=8
RAG_MEMORY_MAX_CHARACTERS=6000
RAG_RETRIEVAL_HISTORY_CHARACTERS=1000
RAG_RESEARCH_MAX_QUERIES=4
RAG_RESEARCH_MAX_WEB_QUERIES=3

# Optional Hugging Face credential for model download rate limits.
HF_TOKEN=

# Docker Compose interpolation (these are not application settings).
RAG_IMAGE_TAG=local
RAG_BIND_ADDRESS=127.0.0.1
RAG_PUBLISHED_PORT=8000
RAG_CONTAINER_CPUS=2.0
RAG_CONTAINER_MEMORY=4g
RAG_DATA_VOLUME=rag-studio-data
